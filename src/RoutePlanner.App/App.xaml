<Application x:Class="RoutePlanner.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#101216" />
  <SolidColorBrush x:Key="PanelBrush" Color="#191C21" />
  <Style TargetType="Window">
   <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
   <Setter Property="Foreground" Value="#F0F1F2" />
   <Setter Property="FontFamily" Value="Segoe UI" />
   <Setter Property="FontSize" Value="13" />
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EAED" /></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#30363E" /><Setter Property="Foreground" Value="#FFFFFF" />
   <Setter Property="BorderBrush" Value="#505760" /><Setter Property="Padding" Value="12,7" />
   <Setter Property="Margin" Value="0,0,6,6" /><Setter Property="MinHeight" Value="32" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#242930" /><Setter Property="Foreground" Value="White" />
   <Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="#525962" />
   <Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,4,0,8" />
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#20242A" /><Setter Property="Foreground" Value="White" />
   <Setter Property="BorderBrush" Value="#3B424C" />
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,7" /></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White" /><Setter Property="Margin" Value="0,6,0,6" /></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0,4,0,8" /></Style>
 </Application.Resources>
</Application>
