<Window x:Class="RoutePlanner.App.CompactWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RoutePlanner.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Style="{StaticResource {x:Type Window}}" Title="Route Planner · Kompakt" Width="390" Height="570" MinWidth="330" MinHeight="450" ResizeMode="CanResizeWithGrip">
 <Border BorderBrush="#333333" BorderThickness="1" Background="#080808"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="16,0,8,0"><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource QuietButton}" Click="ReturnToPlanner" Width="34" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><TextBlock Text="╱╱   ROUTE PLANNER" FontSize="10" Foreground="#858585" VerticalAlignment="Center"/></DockPanel>
  <StackPanel Grid.Row="1" Margin="18,0,18,14"><TextBlock x:Name="RouteTitle" FontSize="21" FontWeight="SemiBold" Foreground="#E6E6E6" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Metrics" Foreground="#7E7E7E" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="2" Margin="16,0" BorderBrush="#292929" BorderThickness="1" CornerRadius="8"><local:MapView x:Name="CompactMap" Editable="False" ToolTip="Rechts ziehen: verschieben · Mausrad: Zoom" AutomationProperties.AutomationId="CompactMap"/></Border>
  <StackPanel Grid.Row="3" Margin="18,14,18,18">
   <TextBlock x:Name="ProgressLabel" Text="Keine aktive Route" FontSize="11" Foreground="#B8B8B8" Margin="0,0,0,10"/>
   <Button x:Name="NextPointButton" Content="Wegpunkt erreicht  →" Click="AdvancePoint" Style="{StaticResource PrimaryButton}"/>
   <Grid Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Beenden" Click="StopRoute" FontSize="11"/><Button Grid.Column="2" Content="Zur Planung" Click="ReturnToPlanner" FontSize="11"/></Grid>
   <CheckBox Content="Fenster im Vordergrund" Checked="TopmostChanged" Unchecked="TopmostChanged" FontSize="11" AutomationProperties.AutomationId="Topmost"/>
   <TextBlock Text="Manuelle Fortschritte · keine Live-Ortung" FontSize="10" Foreground="#656565" Margin="0,10,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
