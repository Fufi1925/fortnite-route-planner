<Window x:Class="RoutePlanner.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RoutePlanner.App"
 Style="{StaticResource {x:Type Window}}"
 Title="Routenatelier · Offline-Demo" Width="1260" Height="850" MinWidth="940" MinHeight="520"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="Demo abspielen" Click="StartDemo" AutomationProperties.AutomationId="StartDemo"/>
    <Button Content="Kompaktansicht ↗" Click="OpenCompact" AutomationProperties.AutomationId="OpenCompact"/>
   </StackPanel>
   <StackPanel><TextBlock Text="ROUTENATELIER" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Eigene Wege. In Ruhe geplant." Foreground="#A3ADB5" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#252C34" BorderBrush="#485360" BorderThickness="1" Padding="12" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="OFFLINE / DEMO — Keine Fortnite-Verbindung. Keine Live-Erkennung." FontWeight="SemiBold"/>
    <TextBlock Text="Nur neutrale Testdaten. Kompaktfenster nur über neutralen Anwendungen prüfen; keine Freigabe für den Einsatz mit Fortnite." TextWrapping="Wrap" Foreground="#BDC5CD" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="MEINE ROUTEN" FontWeight="SemiBold" Foreground="#A3ADB5"/>
      <ComboBox x:Name="RoutesBox" DisplayMemberPath="Name" SelectionChanged="SelectRoute" AutomationProperties.AutomationId="Routes"/>
      <WrapPanel><Button Content="Neu" Click="NewRoute"/><Button Content="Duplizieren" Click="DuplicateRoute"/><Button Content="Löschen" Click="DeleteRoute"/></WrapPanel>
      <TextBox x:Name="NameBox" MaxLength="120" TextChanged="RenameRoute" AutomationProperties.AutomationId="RouteName"/>
      <WrapPanel><Button Content="Speichern" Click="SaveRoute" AutomationProperties.AutomationId="SaveRoute"/>
       <Button Content="Laden" Click="ReloadRoute"/><Button Content="Import" Click="ImportRoute"/><Button Content="Export" Click="ExportRoute"/></WrapPanel>
      <Separator Margin="0,8,0,16"/>
      <TextBlock Text="SUCHRADIUS" FontWeight="SemiBold" Foreground="#A3ADB5"/>
      <TextBlock x:Name="RadiusLabel" Margin="0,8,0,0"/>
      <Slider x:Name="RadiusSlider" Minimum="0" Maximum="1500" TickFrequency="10" ValueChanged="ChangeRadius" AutomationProperties.Name="Suchradius"/>
      <ComboBox x:Name="UnitsBox" SelectedIndex="0" SelectionChanged="ChangeUnits">
       <ComboBoxItem Content="Karteneinheiten (KE)"/><ComboBoxItem Content="Prozent der Kartenbreite"/>
      </ComboBox>
      <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ChangeMode">
       <ComboBoxItem Content="Korridor entlang der Strecke"/><ComboBoxItem Content="Kreise um Wegpunkte"/>
      </ComboBox>
      <TextBlock Text="Planare Demo-Karte: 0…3000 KE je Achse. Keine Umrechnung in reale Meter." TextWrapping="Wrap" Foreground="#A3ADB5" FontSize="11"/>
      <TextBlock Text="WEGPUNKTE" FontWeight="SemiBold" Foreground="#A3ADB5" Margin="0,22,0,8"/>
      <ListBox x:Name="PointsBox" Height="150" SelectionChanged="SelectPoint" AutomationProperties.AutomationId="Waypoints"/>
      <WrapPanel Margin="0,8,0,0"><Button Content="↑" Click="MoveUp" AutomationProperties.Name="Wegpunkt nach oben"/>
       <Button Content="↓" Click="MoveDown" AutomationProperties.Name="Wegpunkt nach unten"/><Button Content="Entfernen" Click="RemovePoint"/></WrapPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBox x:Name="PointX" ToolTip="X in KE" AutomationProperties.Name="Wegpunkt X" Margin="0,0,4,8"/>
       <TextBox x:Name="PointY" Grid.Column="1" ToolTip="Y in KE" AutomationProperties.Name="Wegpunkt Y" Margin="4,0,0,8"/>
      </Grid>
      <Button Content="Koordinaten übernehmen" Click="SetPoint"/>
      <Button Content="Lokale Daten löschen …" Click="ClearData" Margin="0,20,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <WrapPanel DockPanel.Dock="Right"><Button Content="−" Click="ZoomOut" AutomationProperties.Name="Verkleinern"/><Button Content="+" Click="ZoomIn" AutomationProperties.Name="Vergrößern"/><Button Content="Einpassen" Click="FitMap"/></WrapPanel>
     <StackPanel><TextBlock x:Name="MapVersionLabel" FontWeight="SemiBold"/>
      <TextBlock x:Name="RouteMetrics" Foreground="#A3ADB5" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="#3C454F">
     <local:MapView x:Name="PlannerMap" AutomationProperties.AutomationId="PlannerMap" AutomationProperties.Name="Demo-Karte, Linksklick setzt Wegpunkt"/>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,10,0,12">
     <TextBlock Text="○ Möglicher Spawn (DEMO)     □ Manuell bestätigt (Demo-Sichtung, diese Sitzung)     ① Start · ② Wegpunkt · ⚑ Ziel" TextWrapping="Wrap" FontSize="11"/>
     <TextBlock Text="Klick: Punkt setzen / Spawn markieren · Punkt ziehen: bearbeiten · Rechts ziehen: verschieben · Mausrad: zoomen" Foreground="#A3ADB5" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12">
     <DockPanel><Button DockPanel.Dock="Right" Content="Demo stoppen" Click="StopDemo" VerticalAlignment="Top"/>
      <StackPanel><TextBlock Text="DEMO-RUNDEN · LOKALER VERLAUF" FontWeight="SemiBold" Foreground="#A3ADB5"/>
       <TextBlock x:Name="ProviderStatus" Margin="0,5,0,8" TextWrapping="Wrap"/>
       <ListBox x:Name="HistoryBox" Height="70" BorderThickness="0" AutomationProperties.AutomationId="DemoHistory"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="Bereit · offline" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#BDC5CD"/>
 </Grid>
</Window>
